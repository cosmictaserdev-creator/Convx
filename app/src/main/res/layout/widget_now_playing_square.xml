<?xml version="1.0" encoding="utf-8"?>
<!-- Apple Music style "Now Playing" widget, square (2x2). See the wide variant
     for why the background is a runtime bitmap rather than a tinted drawable,
     and why it carries a static src for the widget picker. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.Convxy">

    <ImageView
        android:id="@+id/widget_np_sq_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_preview"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/widget_np_sq_album_art"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/album_art" />

        <TextView
            android:id="@+id/widget_np_sq_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/not_playing"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_on_card"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_np_sq_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_play"
            android:textSize="13sp"
            android:alpha="0.75"
            android:textColor="@color/widget_on_card"
            android:maxLines="1"
            android:ellipsize="end" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/widget_np_sq_pill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="18dp"
            android:background="@drawable/widget_pill_scrim_light">

            <ImageView
                android:id="@+id/widget_np_sq_play_pause"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_play"
                android:contentDescription="@string/play_pause" />

            <TextView
                android:id="@+id/widget_np_sq_pill_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/widget_play"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_card" />
        </LinearLayout>

        <!-- Progress. Only ticks while playing with the screen on. -->
        <FrameLayout
            android:id="@+id/widget_np_sq_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/widget_np_sq_progress_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.3"
                android:src="@drawable/widget_progress_track"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_np_sq_progress_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_progress_clip"
                android:scaleType="fitXY"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_np_sq_glyph"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:alpha="0.9"
        android:src="@drawable/ic_widget_music_note"
        android:contentDescription="@null" />
</FrameLayout>
