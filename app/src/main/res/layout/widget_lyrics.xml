<?xml version="1.0" encoding="utf-8"?>
<!--
  Lyrics widget. RemoteViews can't scroll smoothly, so instead of animating a
  lyric list this renders a fixed window of lines around the current one: the
  active line at full opacity with its neighbours faded. It steps on line change
  rather than gliding, which is the honest limit of RemoteViews.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.Convxy">

    <ImageView
        android:id="@+id/widget_lyr_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_preview"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_lyr_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tap_to_play"
                    android:textSize="12sp"
                    android:alpha="0.6"
                    android:textColor="@color/widget_on_card"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_lyr_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/not_playing"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_on_card"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_lyr_glyph"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:alpha="0.85"
                android:src="@drawable/ic_widget_music_note"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_lyr_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:alpha="0.35"
                android:textColor="@color/widget_on_card"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_lyr_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="@string/widget_no_lyrics"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_card"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_lyr_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:alpha="0.35"
                android:textColor="@color/widget_on_card"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/widget_lyr_skip_prev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="18dp"
                android:alpha="0.9"
                android:src="@drawable/ic_widget_skip_previous"
                android:contentDescription="@string/previous" />

            <ImageView
                android:id="@+id/widget_lyr_play_pause"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_widget_play"
                android:contentDescription="@string/play_pause" />

            <ImageView
                android:id="@+id/widget_lyr_skip_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="18dp"
                android:alpha="0.9"
                android:src="@drawable/ic_widget_skip_next"
                android:contentDescription="@string/next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
