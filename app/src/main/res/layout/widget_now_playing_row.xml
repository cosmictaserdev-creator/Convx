<?xml version="1.0" encoding="utf-8"?>
<!-- Apple Music style "Now Playing", row form (4x1). Smallest variant in the
     responsive set: art, title/artist, transport. No label, no pill text.
     See the wide variant for the background bitmap and its picker src. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.Convxy">

    <ImageView
        android:id="@+id/widget_np_row_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_preview"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_np_row_album_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/album_art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_np_row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_playing"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_card"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_np_row_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tap_to_play"
                android:textSize="12sp"
                android:alpha="0.75"
                android:textColor="@color/widget_on_card"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_np_row_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:alpha="0.85"
            android:src="@drawable/ic_widget_skip_previous"
            android:contentDescription="@string/previous" />

        <ImageView
            android:id="@+id/widget_np_row_play_pause"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="@string/play_pause" />

        <ImageView
            android:id="@+id/widget_np_row_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="10dp"
            android:alpha="0.85"
            android:src="@drawable/ic_widget_skip_next"
            android:contentDescription="@string/next" />
    </LinearLayout>
</FrameLayout>
